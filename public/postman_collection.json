        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "// Set token (handles both token and accessToken field names)",
                  "const token = res.token || res.accessToken || res.access_token || (res.data && (res.data.token || res.data.accessToken)) || \"\";",
                  "if (token) {",
                  "    pm.environment.set(\"token\", token);",
                  "    console.log(\"✅ token set:\", token);",
                  "}",
                  "",
                  "// Set refresh_token",
                  "const refreshToken = res.refreshToken || res.refresh_token || (res.data && (res.data.refreshToken || res.data.refresh_token)) || \"\";",
                  "if (refreshToken) {",
                  "    pm.environment.set(\"refresh_token\", refreshToken);",
                  "    console.log(\"✅ refresh_token set:\", refreshToken);",
                  "}",
                  "",
                  "// Set user_id (handles various field names)",
                  "const userId = res.userId || res.user_id || res.id || (res.user && (res.user.id || res.user._id || res.user.userId)) || (res.data && (res.data.userId || res.data.user_id || res.data.id || (res.data.user && (res.data.user.id || res.data.user._id)))) || \"\";",
                  "if (userId) {",
                  "    pm.environment.set(\"user_id\", userId);",
                  "    console.log(\"✅ user_id set:\", userId);",
                  "}",
                  "",
                  "// Status code test",
                  "pm.test(\"Login successful - Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Response has token test",
                  "pm.test(\"Response contains token\", function () {",
                  "    pm.expect(token).to.not.be.empty;",
                  "});",
                  "",
                  "// Response time test",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
